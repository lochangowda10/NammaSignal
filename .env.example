# NammaSignal Environment Configuration
# 12-Factor compliant configuration with safe defaults for local-first execution

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# OpenSearch Configuration (Local Docker cluster)
# If OpenSearch is unreachable, NammaSignal automatically degrades gracefully to in-memory spatial indexing
OPENSEARCH_HOSTS=http://localhost:9200
OPENSEARCH_INDEX_NAME=nammasignal_hazards

# AWS Cedar Policy Engine
CEDAR_POLICIES_PATH=./authorization/policies.cedar
CEDAR_SCHEMA_PATH=./authorization/schema.cedarschema

# SQLite Canonical Store
DATABASE_PATH=./persistence/nammasignal.db

# Simulation Defaults
SIMULATION_DEFAULT_SCENARIO=silk_board_cloudburst
